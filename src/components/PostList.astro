---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long', timeZone: 'Asia/Seoul' }).format(d);
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <div>
            <h3>{post.data.title}</h3>
            {post.data.summary && <p>{post.data.summary}</p>}
          </div>
        </a>
      </li>
    ))
  }
</ul>
