---
import type { CollectionEntry } from 'astro:content';
import { localize, dateFormat, type Lang } from '../i18n/ui';
import type { Localized } from '../lib/content';

interface Props {
  posts: Localized<CollectionEntry<'blog'>>[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
---

<ul class="notes">
  {
    posts.map((p) => (
      <li>
        <a href={localize(`/blog/${p.base}/`, lang)}>
          <time datetime={p.entry.data.date.toISOString()}>{dateFormat(p.entry.data.date, lang)}</time>
          <div>
            <h3>{p.entry.data.title}</h3>
            {p.entry.data.summary && <p>{p.entry.data.summary}</p>}
          </div>
        </a>
      </li>
    ))
  }
</ul>
