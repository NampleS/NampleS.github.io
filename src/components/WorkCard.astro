---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { localize, type Lang } from '../i18n/ui';
import type { Localized } from '../lib/content';

interface Props {
  item: Localized<CollectionEntry<'works'>>;
  lang: Lang;
}

const { item, lang } = Astro.props;
const { title, summary, category, cover } = item.entry.data;
---

<a class="work" href={localize(`/works/${item.base}/`, lang)}>
  <div class="work-img rough">
    {
      cover ? (
        <Image src={cover} alt={title} width={760} height={570} />
      ) : (
        <span class="none">no image</span>
      )
    }
  </div>
  <div class="work-txt">
    <span class="cat">{category}</span>
    <h3>{title}</h3>
    {summary && <p>{summary}</p>}
  </div>
</a>
