---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site';
import { getWorks, getPosts } from '../lib/content';

const works = await getWorks();
const posts = await getPosts();

const featured = works.filter((w) => w.data.featured);
const topWorks = (featured.length ? featured : works).slice(0, 6);
const topPosts = posts.slice(0, 4);
---

<Base>
  <section class="wrap hero">
    <span class="eyebrow">{site.eyebrow}</span>
    <h1>{site.headline}</h1>
    <p>{site.intro}</p>
    <div class="hero-links">
      <a class="chip" href="/works/">작업 보기</a>
      <a class="chip" href="/games/">게임 해보기</a>
      {site.links.map((l) => <a class="chip" href={l.href}>{l.label}</a>)}
    </div>
  </section>

  <section class="wrap section" style="padding-top:0;">
    <div class="section-head">
      <h2>작업</h2>
      <a class="link-more" href="/works/">전체 보기 →</a>
    </div>
    {
      topWorks.length ? (
        <div class="grid">
          {topWorks.map((work) => (
            <WorkCard work={work} />
          ))}
        </div>
      ) : (
        <p class="note">
          아직 올린 작업이 없습니다. <code>src/content/works/</code> 폴더에 <code>.md</code> 파일을
          하나 만들면 여기에 자동으로 나타납니다.
        </p>
      )
    }
  </section>

  {
    topPosts.length > 0 && (
      <section class="wrap section" style="padding-top:0;">
        <div class="section-head">
          <h2>기록</h2>
          <a class="link-more" href="/blog/">
            전체 보기 →
          </a>
        </div>
        <PostList posts={topPosts} />
      </section>
    )
  }
</Base>
