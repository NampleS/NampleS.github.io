---
import WorksIndex from '../../../views/WorksIndex.astro';
import { langs, defaultLang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((l) => ({
    params: { lang: l === defaultLang ? undefined : l },
    props: { lang: l },
  }));
}

const { lang } = Astro.props;
---

<WorksIndex lang={lang} />
