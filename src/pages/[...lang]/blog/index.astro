---
import BlogIndex from '../../../views/BlogIndex.astro';
import { langs, defaultLang } from '../../../i18n/ui';

export function getStaticPaths() {
  return langs.map((l) => ({
    params: { lang: l === defaultLang ? undefined : l },
    props: { lang: l },
  }));
}

const { lang } = Astro.props;
---

<BlogIndex lang={lang} />
