---
import Base from '../../layouts/Base.astro';
import { games } from '../../games';

const playable = games.filter((g) => !g.wip);
const soon = games.filter((g) => g.wip);
---

<Base title="게임" description="브라우저에서 바로 할 수 있는 미니게임">
  <section class="wrap section">
    <div class="section-head">
      <h2>게임</h2>
      <span class="link-more">설치 없이 바로 플레이</span>
    </div>

    {
      playable.length ? (
        <div class="grid">
          {playable.map((g) => (
            <a class="card" href={`/games/${g.slug}/index.html`}>
              <div class="thumb" style="aspect-ratio:16/10;">
                <span style="font-size:2.4rem;">🎮</span>
              </div>
              <div class="body">
                <span class="cat">{g.controls}</span>
                <h3>{g.title}</h3>
                <p>{g.summary}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty">아직 올린 게임이 없습니다.</p>
      )
    }

    {
      soon.length > 0 && (
        <div style="margin-top:2.5rem;">
          <h3 class="eyebrow" style="display:block; margin-bottom:1rem;">
            준비 중
          </h3>
          <div class="grid">
            {soon.map((g) => (
              <div class="card" style="opacity:0.55; cursor:default;">
                <div class="body">
                  <span class="cat">준비 중</span>
                  <h3>{g.title}</h3>
                  <p>{g.summary}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>
</Base>
